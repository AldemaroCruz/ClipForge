# Independent CI allowlist. The production/runtime .dockerignore is unchanged.
**
!app/
!app/*.py
!app/static/
!app/static/*.html
!app/static/*.js
!app/static/*.css
!scripts/
!scripts/*.py
!scripts/*.ps1
!tests/
!tests/*.py
!Dockerfile
!Dockerfile.ci
!Dockerfile.ci.dockerignore
!requirements.txt
!requirements-test.txt
!requirements-ci.lock
!requirements-ci-tools.txt
!requirements-ci-tools.lock

# Defense in depth if somebody supplies a context without the preparation tool.
**/.env*
**/credentials*
**/credential.*
**/secrets*
**/secret.*
**/tokens*
**/token.*
**/auth.json
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.tfstate*
**/__pycache__/
**/*.pyc
**/data/
**/cache/
**/backups/
**/release/
**/evidence/
**/test-evidence/
**/test-output/
**/restore-check-*/
**/*.mp4
**/*.mov
**/*.mkv
**/*.webm
**/*.zip
**/*.tar
