# Copy to .env.ai. This is a SERVER file; never commit it or paste the key in chat.
# Default is safe: no model call even when this overlay is used.
CLIPFORGE_AI_PROVIDER=disabled
# Options: disabled | openai | ollama
CLIPFORGE_AI_MODEL=gpt-6-luna
OPENAI_API_KEY=

# For Ollama use a locally downloaded, instruction-following model supporting JSON.
# Change MODEL to your exact installed tag, e.g. qwen2.5:7b.
# No cloud model tags. ClipForge does not download or start Ollama.
CLIPFORGE_OLLAMA_URL=http://host.docker.internal:11434
CLIPFORGE_OLLAMA_NUM_CTX=16384

# One request at a time; failed/interrupted attempts also reserve daily quota (UTC).
CLIPFORGE_AI_DAILY_LIMIT=10
CLIPFORGE_AI_MAX_INPUT_CHARS=60000
CLIPFORGE_AI_MAX_OUTPUT_TOKENS=4000
CLIPFORGE_AI_TIMEOUT_SECONDS=180
